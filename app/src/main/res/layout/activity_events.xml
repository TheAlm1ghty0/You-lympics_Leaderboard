<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212"
    tools:context=".EventsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Event to Score"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/button_event1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 1 (Timed)"
        android:onClick="onEventButtonClick"
        android:tag="1"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_event2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 2 (Timed)"
        android:onClick="onEventButtonClick"
        android:tag="2"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_event3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 3 (Timed)"
        android:onClick="onEventButtonClick"
        android:tag="3"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_event4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 4 (Timed)"
        android:onClick="onEventButtonClick"
        android:tag="4"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_event5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 5 (Positional)"
        android:onClick="onEventButtonClick"
        android:tag="5"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_event6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event 6 (Positional)"
        android:onClick="onEventButtonClick"
        android:tag="6"/>

</LinearLayout>
