<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Current Active Round"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/radioGroup_rounds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioButton_round1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 1"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/radioButton_round2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 2"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/radioButton_round3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 3"
            android:textSize="16sp"/>
    </RadioGroup>

</LinearLayout>
