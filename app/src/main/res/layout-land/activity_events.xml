<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212"
    tools:context=".EventsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Event to Score"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/button_event1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strawpedo"
                android:onClick="onEventButtonClick"
                android:tag="1"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Race 2 Pint"
                android:onClick="onEventButtonClick"
                android:tag="2"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crab Run"
                android:onClick="onEventButtonClick"
                android:tag="3"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ping Pong Run"
                android:onClick="onEventButtonClick"
                android:tag="4"/>

        </LinearLayout>

        <!-- Right Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <Button
                android:id="@+id/button_event5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Elimination Stacks"
                android:onClick="onEventButtonClick"
                android:tag="5"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Elimination Slaps"
                android:onClick="onEventButtonClick"
                android:tag="6"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event 7 (Coming Soon)"
                android:enabled="false"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/button_event8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event 8 (Coming Soon)"
                android:enabled="false"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
