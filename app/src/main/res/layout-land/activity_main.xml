<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Top 3 Podium -->
    <LinearLayout
        android:id="@+id/podium_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 2nd Place -->
        <LinearLayout
            android:id="@+id/container_2nd_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:src="@android:drawable/star_on"
                app:tint="#C0C0C0"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textView_2nd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                tools:text="Carrie" />

            <TextView
                android:id="@+id/textView_2nd_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C0C0C0"
                android:textSize="16sp"
                tools:text="90" />
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="#C0C0C0"/>
        </LinearLayout>

        <!-- 1st Place -->
        <LinearLayout
            android:id="@+id/container_1st_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:src="@android:drawable/star_on"
                app:tint="#FFD700"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textView_1st_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Callum" />

            <TextView
                android:id="@+id/textView_1st_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textSize="20sp"
                tools:text="100" />
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#FFD700"/>
        </LinearLayout>

        <!-- 3rd Place -->
        <LinearLayout
            android:id="@+id/container_3rd_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:src="@android:drawable/star_on"
                app:tint="#CD7F32"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textView_3rd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                tools:text="Charlotte" />

            <TextView
                android:id="@+id/textView_3rd_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CD7F32"
                android:textSize="16sp"
                tools:text="80" />
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="#CD7F32"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Rest of the players -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_leaderboard_rest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/podium_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/leaderboard_item"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_to_events"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_edit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Enter Scores"
        app:tint="@android:color/white"/>

</androidx.constraintlayout.widget.ConstraintLayout>
